{
  "name": "ayurtech-average-api",
  "version": "1.0.0",
  "description": "A robust REST API server in Node.js that calculates running average with Conventional Commits, Git hooks, and multiple clients.",
  "main": "server.js",
  "bin": {
    "average-cli": "./bin/cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --verbose",
    "test:coverage": "jest --runInBand --coverage",
    "client": "node bin/cli.js",
    "docs": "jsdoc -c jsdoc.json",
    "prepare": "husky"
  },
  "keywords": [
    "rest-api",
    "nodejs",
    "express",
    "average",
    "conventional-commits",
    "git-hooks",
    "husky"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.5",
    "supertest": "^7.0.0"
  }
}
